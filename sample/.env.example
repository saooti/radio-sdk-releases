# Configuration locale facultative. Ne pas distribuer le fichier rempli.
# Priorité : arguments de lancement, environnement, fichier, valeurs par défaut.
SAOOTI_RADIO_ID=
# Facultatif : prioritaire sur SAOOTI_RADIO_ID, radio déterminée via l'API.
SAOOTI_RADIO_CIP=
SAOOTI_RADIO_PLATFORM=prod
SAOOTI_RADIO_LOCALE=auto
SAOOTI_RADIO_URL_PARAMS=
SAOOTI_RADIO_USERNAME=
SAOOTI_RADIO_PASSWORD=
# Facultatif : origine API de résolution du CIP ; HTTPS ou HTTP local uniquement.
# SAOOTI_RADIO_API_BASE_URL=
# SAOOTI_RADIO_LOG_LEVEL=info

# Signature Windows uniquement, pendant la construction.
WINDOWS_SIGNING_MODE=none
# WINDOWS_CERTIFICATE_SUBJECT=
# WINDOWS_CERTIFICATE_SHA1=
# WINDOWS_TIMESTAMP_URL=http://timestamp.sectigo.com
